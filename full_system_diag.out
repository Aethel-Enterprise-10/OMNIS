                    ts TEXT NOT NULL,
                    route TEXT NOT NULL,
                    query TEXT,
                    response TEXT,
                    subsystem TEXT,
                    success INTEGER NOT NULL,
                    error TEXT
                );
CREATE TABLE events (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    ts TEXT NOT NULL,
                    type TEXT NOT NULL,
                    data TEXT
                );
CREATE TABLE sqlite_sequence(name,seq);
CREATE TABLE modules (
                    name TEXT PRIMARY KEY,
                    path TEXT,
                    loaded INTEGER,
                    capabilities TEXT,
                    error TEXT,
                    updated_at TEXT
                );

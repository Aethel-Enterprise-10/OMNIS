============================================================
=== OMNIS DISCOVERY IMPLEMENTATION ===
============================================================

EXCLUDED_DIRS = {
    "__pycache__",
    ".git",
    ".venv",
    "venv",
    "node_modules",
}

SAFE_ROOT_NAMES = {
    "SHOGUN_OS",
    "deep_recon",
    "T-PRAO_L4",
    "T4_CHAT_BOX",
    "AETHERCORE",
    "VERITY",
    "OMNIS",
    "omnis",
    "AAR_CORE",
    "BIRTH_EDGE",
    "BIRTH_EDGE_REPLICA",
    "BLOOM",
}


def candidate_roots():
    roots = []

    for name in SAFE_ROOT_NAMES:
        root = HOME / name

        try:
            if root.exists() and root.is_dir():
                roots.append(root)
        except Exception:
            pass

    return roots


def discover_python_files():
    found = set()

    for root in candidate_roots():
        try:
            for path in root.rglob("*.py"):
                if any(
                    part in EXCLUDED_DIRS
                    for part in path.parts
                ):
                    continue

                if path.resolve() == Path(__file__).resolve():
                    continue

                found.add(path)

        except Exception as exc:
            event(
                "discovery_scan_error",
                {
                    "root": str(root),
                    "error": str(exc),
                },
            )

    return sorted(found)


def looks_relevant(path):
    signals = (
        "orchestrator",
        "reasoner",
        "reason",
        "memory",
        "ask_llm",
        "agent",
        "research",
        "finance",
        "cognition",
        "decision",
        "nominal",
        "aether",
        "omnis",
        "shogun",
        "verity",
        "adaptive",
        "learning",
        "rule",
    )

    try:
        return any(
            signal in path.name.lower()
            for signal in signals
        )
    except Exception:
        return False


def import_file(path):
    name = (
        "omnis_dynamic_"
        + hashlib.sha256(
            str(path).encode()
        ).hexdigest()[:16]
    )

    try:
        spec = importlib.util.spec_from_file_location(
            name,
            str(path),
        )

        if spec is None or spec.loader is None:
            raise RuntimeError(
                "No import specification"
            )

        module = importlib.util.module_from_spec(spec)

        module_dir = str(path.parent)

        if module_dir not in sys.path:
            sys.path.insert(0, module_dir)

        sys.modules[name] = module
        spec.loader.exec_module(module)

        REGISTRY.register(
            name,
            module,
            path,
        )

        return module

    except Exception:
        REGISTRY.fail(
            name,
            path,
            traceback.format_exc(),
        )
        return None


def discover_modules():
    """
    Discovery is deliberately NOT executed during startup.

    It can be invoked explicitly through /discover.
    """

    event("discovery_started")

    files = discover_python_files()
    relevant = [
        path
        for path in files
        if looks_relevant(path)
    ]

    loaded_before = len(REGISTRY.loaded)
    failed_before = len(REGISTRY.failed)

    for path in relevant:
        import_file(path)

    result = {
        "scanned": len(files),
        "relevant": len(relevant),
        "loaded": len(REGISTRY.loaded) - loaded_before,
        "failed": len(REGISTRY.failed) - failed_before,
        "total_loaded": len(REGISTRY.loaded),
        "total_failed": len(REGISTRY.failed),
    }

    event("discovery_complete", result)

    return result



@app.route("/events", methods=["GET"])
def events():

    limit = request.args.get(
        "limit",
        default=50,
        type=int,
    )

    limit = max(
        1,
        min(limit, 500),
    )

    con = db()

    try:

        rows = con.execute(
            """
            SELECT id,ts,type,data
            FROM events
            ORDER BY id DESC
            LIMIT ?
            """,
            (limit,),
        ).fetchall()

        result = []

        for row in rows:

            try:
                payload = json.loads(
                    row["data"]
                )
            except Exception:
                payload = row["data"]

            result.append(
                {
                    "id": row["id"],
                    "ts": row["ts"],
                    "type": row["type"],
                    "data": payload,
                }
            )

        return jsonify(
            {
                "events": result,
                "count": len(result),
            }
        )

    finally:
        con.close()


# ============================================================
# MAIN
# ============================================================

if __name__ == "__main__":

    print("=" * 72, flush=True)
    print(APP_NAME, flush=True)
    print("VERSION:", VERSION, flush=True)
    print("=" * 72, flush=True)
    print("PID:", os.getpid(), flush=True)
    print("Python:", sys.version.split()[0], flush=True)
    print("Platform:", sys.platform, flush=True)
    print("Database:", DB_PATH, flush=True)
    print("Loaded modules:", len(REGISTRY.loaded), flush=True)
    print("Failed modules:", len(REGISTRY.failed), flush=True)
    print("Discovery:", "EXPLICIT /discover", flush=True)
    print(
        f"Listening: http://{HOST}:{PORT}",
        flush=True,
    )
    print("=" * 72, flush=True)

    app.run(
        host=HOST,
        port=PORT,
        debug=False,
        threaded=True,
        use_reloader=False,
    )


